{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "findrss-worker-example",
  "account_id": "13ca31f4970253df1202e534bf8309be",
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "13ca31f4970253df1202e534bf8309be",
    "CLOUDFLARE_WORKER_NAME": "findrss-worker-example"
  },
  "main": "index.js",
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/rank",
      "/rank/*",
      "/admin",
      "/admin/*",
      "/api/*",
      "/discovery/*",
      "/public",
      "/public/*",
      "/clips/*",
      "/health",
      "/mcp",
      "/oauth/*",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/*",
      "/.well-known/oauth-authorization-server",
      "/v1",
      "/v1/*",
      "/reader/*",
      "/rss/*",
      "/atom/*",
      "/debug/*",
      "/_internal/*",
      "/_admin/*",
      "/wxmpimgproxy",
      "/findrss-logo.png"
    ]
  },
  "alias": {
    "timeless": "./public/assets/timeless/0.34.2/timeless.lite.esm.js",
    "timeless-ssr": "./public/assets/timeless/0.34.2/timeless.ssr.esm.js"
  },
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  // 两类业务日志由 Workers Logs 保存；关闭额外请求日志，避免设备心跳重复计数。
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.css",
        "**/*.svg"
      ],
      "fallthrough": true
    },
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": false
    }
  ],
  // R2 对象存储桶，由 Wrangler 统一部署。
  "r2_buckets": [
    {
      "binding": "API_STORAGE",
      "bucket_name": "findrss-storage"
    }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "findrss-db", "database_id": "82c74e18-9e2b-4fb6-843e-753ed0ab60f1", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "8f43a430c17a4cd5999ed68c0a9314e6" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "findrss-jobs" }],
    "consumers": [{ "queue": "findrss-jobs", "max_batch_size": 1, "max_concurrency": 16, "max_retries": 10 }]
  },
  "services": [{ "binding": "APPLICATION_SERVICE", "service": "findrss-worker-example", "entrypoint": "ApplicationEntrypoint" }],
  "durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "RealtimeHubDO" }] },
  "exports": {
    "RealtimeHubDO": { "type": "durable-object", "storage": "sqlite" },
    "APIDurableObject": { "type": "durable-object", "storage": "sqlite" }
  },
  "secrets": {
    "required": [
      "ADMIN_PASSWORD"
    ]
  }
}
